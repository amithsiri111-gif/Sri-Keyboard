{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FFF4E6" },
      "foreground": { "$value": "#39271F" },
      "border": { "$value": "#DCC5B2" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#39271F" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#39271F" },
      "primary": {
        "$value": "#573321",
        "$description": "Sinhala Sand activated-label color, used for primary actions."
      },
      "primaryForeground": { "$value": "#FFFDF7" },
      "secondary": { "$value": "#F2E0D0" },
      "secondaryForeground": { "$value": "#39271F" },
      "muted": { "$value": "#F2E0D0" },
      "mutedForeground": { "$value": "#795548" },
      "accent": { "$value": "#E8B78E" },
      "accentForeground": { "$value": "#39271F" },
      "destructive": { "$value": "#B3261E" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#DCC5B2" },
      "ring": { "$value": "#573321" },
      "chart1": { "$value": "#8B5E3C" },
      "chart2": { "$value": "#3E7A4A" },
      "chart3": { "$value": "#C6512F" },
      "chart4": { "$value": "#B68900" },
      "chart5": { "$value": "#8B3D5C" },
      "sidebar": { "$value": "#FFF4E6" },
      "sidebarForeground": { "$value": "#39271F" },
      "sidebarBorder": { "$value": "#DCC5B2" },
      "sidebarPrimary": { "$value": "#573321" },
      "sidebarPrimaryForeground": { "$value": "#FFFDF7" },
      "sidebarAccent": { "$value": "#F2E0D0" },
      "sidebarAccentForeground": { "$value": "#39271F" },
      "sidebarRing": { "$value": "#573321" }
    },
    "dark": {
      "background": { "$value": "#2A080E" },
      "foreground": { "$value": "#FFFDF7" },
      "border": { "$value": "#6B1D2C" },
      "card": { "$value": "#4A121D" },
      "cardForeground": { "$value": "#FFFDF7" },
      "popover": { "$value": "#3E0E18" },
      "popoverForeground": { "$value": "#FFFDF7" },
      "primary": { "$value": "#FFC107" },
      "primaryForeground": { "$value": "#2A080E" },
      "secondary": { "$value": "#801826" },
      "secondaryForeground": { "$value": "#FFFDF7" },
      "muted": { "$value": "#3E0E18" },
      "mutedForeground": { "$value": "#FFC107" },
      "accent": { "$value": "#FFD54F" },
      "accentForeground": { "$value": "#2A080E" },
      "destructive": { "$value": "#FF8A80" },
      "destructiveForeground": { "$value": "#2A080E" },
      "input": { "$value": "#6B1D2C" },
      "ring": { "$value": "#FFC107" },
      "chart1": { "$value": "#FFC107" },
      "chart2": { "$value": "#FFF8E1" },
      "chart3": { "$value": "#FF8A80" },
      "chart4": { "$value": "#FFA726" },
      "chart5": { "$value": "#B8E986" },
      "sidebar": { "$value": "#21060B" },
      "sidebarForeground": { "$value": "#FFFDF7" },
      "sidebarBorder": { "$value": "#6B1D2C" },
      "sidebarPrimary": { "$value": "#FFC107" },
      "sidebarPrimaryForeground": { "$value": "#2A080E" },
      "sidebarAccent": { "$value": "#4A121D" },
      "sidebarAccentForeground": { "$value": "#FFFDF7" },
      "sidebarRing": { "$value": "#FFD54F" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "Noto Sans Sinhala", "sans-serif"],
        "$description": "Inter for Latin UI text, with Noto Sans Sinhala for Sinhala glyphs."
      },
      "serif": { "$value": ["Noto Serif Sinhala", "Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Noto Sans Sinhala", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
